# ECC environment variables (copy to .env and fill in real values)
# NEVER commit real secrets. .env is already in .gitignore.

# Matching engine mode: "baseline" (default, rule-based) or "ml" (Linear Regression, pending approval)
MATCHING_METHOD=baseline

# Optional: Gemini API key (not integrated into matching engine by default — YAGNI, spec keeps ML pending)
# GEMINI_API_KEY=your_key_here
